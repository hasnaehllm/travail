<Window x:Class="Travail.ToDoListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Travail"
        Title="To-Do List" Height="350" Width="525">

    <Window.Resources>
        <local:IsDoneToColorConverter x:Key="IsDoneToColorConverter"/>
        <local:IsDoneToTextDecorationConverter x:Key="IsDoneToTextDecorationConverter"/>
    </Window.Resources>

    <Grid>
        <ListBox Name="TasksListBox" HorizontalAlignment="Left" Height="200" VerticalAlignment="Top" Width="480" Margin="10,40,10,0" 
                 ItemsSource="{Binding Tasks}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <CheckBox IsChecked="{Binding IsDone}" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding Title}" 
                                   VerticalAlignment="Center" 
                                   Foreground="{Binding IsDone, Converter={StaticResource IsDoneToColorConverter}}"
                                   TextDecorations="{Binding IsDone, Converter={StaticResource IsDoneToTextDecorationConverter}}" 
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBox Name="TaskTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="400" Margin="10,250,10,0"/>

        <Button Content="Ajouter" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Margin="10,280,0,0" Click="AddTask_Click"/>

        <Button Content="Supprimer" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Margin="100,280,0,0" Click="DeleteTask_Click"/>
    </Grid>
</Window>
