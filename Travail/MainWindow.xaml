<Window x:Class="Travail.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="av"
        Title="Envoi d'Email"
        Height="450" Width="638">
    <Grid Margin="85,10,154,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="49*"/>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="275*"/>
        </Grid.RowDefinitions>
        <Menu VerticalAlignment="Top" Height="24" Margin="0,2,0,0">
            <MenuItem Header="Menu" Height="19">
                <MenuItem Header="To-Do List" Click="OpenToDoList_Click"/>
                <!-- Ajoutez cette ligne pour ouvrir le Chronomètre -->
                <MenuItem Header="Chronomètre" Click="OpenChronometer_Click"/>
                <MenuItem Header="CommunicationRéseau" Click="OpenCommunicationRéseau_Click"/>


            </MenuItem>
        </Menu>

        <TextBlock Text="Adresse e-mail de l'utilisateur" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,31,0,0"/>
        <TextBox x:Name="UserEmailTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Margin="10,3,0,0" Grid.Row="1"/>

        <TextBlock Text="Mot de passe" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="1" Grid.RowSpan="2"/>
        <PasswordBox x:Name="UserPasswordBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Margin="10,11,0,0" Grid.Row="2"/>

        <TextBlock Text="Adresse e-mail du destinataire" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,4,0,0" Grid.Row="3"/>
        <TextBox x:Name="RecipientEmailTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Margin="10,27,0,0" Grid.Row="3"/>

        <TextBlock Text="Objet" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,56,0,0" Grid.Row="3"/>
        <TextBox x:Name="SubjectTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Margin="10,78,0,0" Grid.Row="3"/>

        <TextBlock Text="Message" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,108,0,0" Grid.Row="3"/>
        <TextBox x:Name="MessageTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Height="100" Margin="10,128,0,0" VerticalScrollBarVisibility="Auto" Grid.Row="3"/>

        <TextBlock x:Name="ErrorMessageTextBlock" HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Margin="10,261,0,0" Foreground="Red" Grid.Row="3"/>

        <Button x:Name="SendButton" Content="Envoyer" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Margin="115,232,0,0" Click="SendEmailButton_Click" Grid.Row="3"/>

        <TextBlock x:Name="StatusTextBlock" HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Margin="10,291,0,0" Foreground="Green" Grid.Row="3"/>

        <ProgressBar x:Name="ProgressBar" Width="160" Height="16" IsIndeterminate="True" Visibility="Collapsed" Margin="120,70,119,189" Grid.Row="3"/>
    </Grid>
</Window>
