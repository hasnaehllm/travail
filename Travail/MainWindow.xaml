<Window x:Class="Travail.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Envoi d'Email" Height="450" Width="638">
    <Grid Margin="154,10,154,30">
        <TextBlock Text="Adresse e-mail de l'utilisateur" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,0,0,0"/>
        <TextBox x:Name="UserEmailTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Margin="10,25,0,0"/>

        <TextBlock Text="Mot de passe" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,50,0,0"/>
        <PasswordBox x:Name="UserPasswordBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Margin="10,72,0,0"/>

        <TextBlock Text="Adresse e-mail du destinataire" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,108,0,0"/>
        <TextBox x:Name="RecipientEmailTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Margin="10,135,0,0"/>

        <TextBlock Text="Objet" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,161,0,0"/>
        <TextBox x:Name="SubjectTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Margin="10,187,0,0"/>

        <TextBlock Text="Message" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,221,0,0"/>
        <TextBox x:Name="MessageTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Height="100" Margin="10,247,0,0" VerticalScrollBarVisibility="Auto"/>

        <TextBlock x:Name="ErrorMessageTextBlock" HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Margin="10,380,0,0" Foreground="Red"/>

        <Button x:Name="SendButton" Content="Envoyer" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Margin="98,351,0,0" Click="SendEmailButton_Click"/>

        <TextBlock x:Name="StatusTextBlock" HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Margin="10,410,0,0" Foreground="Green"/>

        <ProgressBar x:Name="ProgressBar" Width="160" Height="16" IsIndeterminate="True" Visibility="Collapsed"/>
    </Grid>
</Window>
