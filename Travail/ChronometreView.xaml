<UserControl x:Class="Travail.ChronometreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Travail">
    <UserControl.DataContext>
        <local:ChronometerViewModel />
    </UserControl.DataContext>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Chronomètre analogique -->
        <Viewbox Grid.Row="0" Margin="20">
            <Canvas Width="300" Height="300">
                <!-- Cercle principal -->
                <Ellipse Width="300" Height="300" 
                         Stroke="Black" 
                         StrokeThickness="4" 
                         Fill="WhiteSmoke"/>

                <!-- Marques des heures (12 marques) -->
                <ItemsControl ItemsSource="{Binding MarquesHeures}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Line X1="150" Y1="15" X2="150" Y2="35" 
                                  Stroke="Black" StrokeThickness="3">
                                <Line.RenderTransform>
                                    <RotateTransform Angle="{Binding}" CenterX="150" CenterY="150"/>
                                </Line.RenderTransform>
                            </Line>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Centre du cadran -->
                <Ellipse Width="12" Height="12" 
                         Canvas.Left="144" Canvas.Top="144"
                         Fill="Black"/>

                <!-- Aiguille des heures -->
                <Line X1="150" Y1="150" X2="150" Y2="90" 
                      Stroke="#333333" StrokeThickness="6"
                      StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <RotateTransform Angle="{Binding AngleHeures}" CenterX="150" CenterY="150"/>
                    </Line.RenderTransform>
                </Line>

                <!-- Aiguille des minutes -->
                <Line X1="150" Y1="150" X2="150" Y2="60" 
                      Stroke="#666666" StrokeThickness="4"
                      StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <RotateTransform Angle="{Binding AngleMinutes}" CenterX="150" CenterY="150"/>
                    </Line.RenderTransform>
                </Line>

                <!-- Aiguille des secondes -->
                <Line X1="150" Y1="150" X2="150" Y2="30" 
                      Stroke="Red" StrokeThickness="2"
                      StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <RotateTransform Angle="{Binding AngleSecondes}" CenterX="150" CenterY="150"/>
                    </Line.RenderTransform>
                </Line>
            </Canvas>
        </Viewbox>

        <!-- Affichage numérique -->
        <TextBlock Grid.Row="1" 
                   Text="{Binding TempsAffiche}" 
                   FontSize="32" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20"/>

        <!-- Boutons de contrôle -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
            <Button Content="Démarrer" 
                    Command="{Binding DemarrerCommand}"
                    Width="100" 
                    Height="35" 
                    Margin="5"
                    FontSize="14"/>
            <Button Content="Arrêter" 
                    Command="{Binding ArreterCommand}"
                    Width="100" 
                    Height="35" 
                    Margin="5"
                    FontSize="14"/>
            <Button Content="Réinitialiser" 
                    Command="{Binding ReinitialiserCommand}"
                    Width="120" 
                    Height="35" 
                    Margin="5"
                    FontSize="14"/>
        </StackPanel>
    </Grid>
</UserControl>